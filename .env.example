# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection, used only by drizzle-kit for migrations and by the seed script.
#
# Use the SESSION POOLER string, not the direct one: Supabase moved
# db.<ref>.supabase.co to IPv6-only, and macOS will not resolve it (ENOTFOUND).
# Project Settings › Database › Connection string › Session pooler.
#
# Note the username carries the project ref, and the password replaces the WHOLE
# [YOUR-PASSWORD] block — brackets included.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Where magic-link emails send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 7 only. The app is fully usable with this unset (SPEC §2).
ANTHROPIC_API_KEY=
