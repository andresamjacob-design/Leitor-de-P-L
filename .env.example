# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection, used only by drizzle-kit for migrations and by the seed script.
# Project Settings › Database › Connection string › URI (session pooler).
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Where magic-link emails send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 7 only. The app is fully usable with this unset (SPEC §2).
ANTHROPIC_API_KEY=
