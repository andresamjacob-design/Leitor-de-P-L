{
  "name": "financeiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "verify:import": "vite-node --config vitest.config.ts scripts/verify-import.ts",
    "verify:rls": "vite-node --config vitest.config.ts scripts/verify-rls.ts",
    "propose:rules": "vite-node --config vitest.config.ts scripts/propose-rules.ts",
    "inspect:staged": "vite-node --config vitest.config.ts scripts/inspect-staged.ts",
    "propose:parties": "vite-node --config vitest.config.ts scripts/propose-parties.ts",
    "propose:suppliers": "vite-node --config vitest.config.ts scripts/propose-supplier-rules.ts",
    "preview:categorize": "vite-node --config vitest.config.ts scripts/preview-categorize.ts",
    "import:invoices": "vite-node --config vitest.config.ts scripts/import-invoices.ts",
    "propose:contracts": "vite-node --config vitest.config.ts scripts/propose-contracts.ts",
    "recognize:manual": "vite-node --config vitest.config.ts scripts/recognize-manual.ts",
    "pendencias": "vite-node --config vitest.config.ts scripts/pendencias.ts",
    "fix:credits": "vite-node --config vitest.config.ts scripts/fix-cost-credits.ts",
    "propose:cdb": "vite-node --config vitest.config.ts scripts/propose-cdb-legs.ts",
    "verify:reconcile": "vite-node --config vitest.config.ts scripts/verify-reconcile.ts",
    "propose:receipts": "vite-node --config vitest.config.ts scripts/propose-receipts.ts",
    "decisoes": "vite-node --config vitest.config.ts scripts/decisoes.ts",
    "vincular": "vite-node --config vitest.config.ts scripts/vincular-clientes.ts",
    "import:sispag": "vite-node --config vitest.config.ts scripts/import-sispag.ts",
    "recategorize": "vite-node --config vitest.config.ts scripts/recategorize.ts",
    "boletos": "vite-node --config vitest.config.ts scripts/partir-boletos.ts",
    "socios": "vite-node --config vitest.config.ts scripts/distribuicao-socios.ts",
    "comparar": "vite-node --config vitest.config.ts scripts/comparar-dre.ts",
    "comparar:fluxo": "vite-node --config vitest.config.ts scripts/comparar-fluxo.ts",
    "lotes": "vite-node --config vitest.config.ts scripts/lotes-sispag.ts",
    "corrigir": "vite-node --config vitest.config.ts scripts/corrigir-conta.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.60.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.476.0",
    "next": "^16.3.0",
    "postgres": "^3.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.0"
  }
}
